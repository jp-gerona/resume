---
import { getResumeUpdatedDate } from "@/utils/resumeUpdated";
import config from "../../resume.config.mjs";

const updatedDate = getResumeUpdatedDate();
const updatedLabel = new Intl.DateTimeFormat(config.lang, {
  year: "numeric",
  month: "long",
  day: "numeric",
  hour: "numeric",
  minute: "2-digit",
}).format(updatedDate);
---

<div>
  <a class="text-link" href="resume.pdf" download={config.pdfFilename}>Download PDF</a>
  <p class="updated">Updated <time datetime={updatedDate.toISOString()}>{updatedLabel}</time></p>
</div>

<style>
  .updated {
    margin-top: 12px;
    font-size: 0.75rem;
    line-height: 1rem;
    color: var(--color-muted);
  }
</style>
