---
import { getEntry } from "astro:content";
import Icon from "@/components/Icon.astro";
import type { IconName } from "@/icons";
import { icons } from "@/icons";
import config from "../../resume.config.mjs";

const entry = await getEntry("resume", "resume");
if (!entry) {
  throw new Error("Missing resume content entry at src/content/resume/resume.yaml");
}
const { name, role, contact } = entry.data;
const site = config.sidebar;
const email = contact.find(item => item.href?.startsWith("mailto:"));
const websiteHost = site.website && new URL(site.website).hostname;
---

<div>
  {site.website
    ? <a class="handle" href={site.website} title={`${name} @ ${websiteHost}`}>{site.handle}</a>
    : <p class="handle">{site.handle}</p>}
  <p class="role">{role}</p>
  {email && <a class="text-link email" href={email.href}>{email.text}</a>}
  <nav class="socials" aria-label="Profile links">
    {site.socials.map((social) => {
      if (!(social.icon in icons)) {
        throw new Error(`resume.config.mjs: unknown social icon "${social.icon}". Choose one of: ${Object.keys(icons).join(", ")}.`);
      }
      return (
      <a
        href={social.href}
        title={`${social.label} @ ${site.handle}`}
        aria-label={`${social.label} @ ${site.handle}, opens in new tab`}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name={social.icon as IconName} />
      </a>
      );
    })}
    {site.website && (
      <a href={site.website} title="Website" aria-label="Website">
        <Icon name="globe" />
      </a>
    )}
  </nav>
</div>

<style>
  .handle {
    display: inline-block;
    font-family: var(--font-serif);
    font-size: 2.5rem;
    letter-spacing: -0.025em;
  }

  .role {
    margin-top: 4px;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: var(--color-muted);
  }

  .email {
    margin-top: 12px;
  }

  .socials {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
  }

  .socials a {
    display: flex;
    color: var(--color-muted);
    transition: color 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .socials a:hover {
    color: var(--color-ink);
  }
</style>
