---
import { getEntry } from "astro:content";
import Icon from "@/components/Icon.astro";
import { siteConfig } from "@/site.config";

const entry = await getEntry("resume", "resume");
if (!entry) {
  throw new Error("Missing resume content entry at src/content/resume/resume.yaml");
}
const email = entry.data.contact.find(contact => contact.href?.startsWith("mailto:"));
const websiteHost = new URL(siteConfig.website).hostname;
---

<div>
  <a class="handle" href={siteConfig.website} title={`${entry.data.name} @ ${websiteHost}`}>{siteConfig.user}</a>
  <p class="role">{entry.data.role}</p>
  {email && <a class="text-link email" href={email.href}>{email.text}</a>}
  <nav class="socials" aria-label="Profile links">
    {siteConfig.socials.map(social => (
      <a
        href={social.href}
        title={`${social.label} @ ${siteConfig.user}`}
        aria-label={`${social.label} @ ${siteConfig.user}, opens in new tab`}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name={social.icon} />
      </a>
    ))}
    <a href={siteConfig.website} title="Portfolio" aria-label="Portfolio">
      <Icon name="globe" />
    </a>
  </nav>
</div>

<style>
  .handle {
    display: inline-block;
    font-family: var(--font-serif);
    font-size: 2.5rem;
    letter-spacing: -0.025em;
  }

  .role {
    margin-top: 4px;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: var(--color-muted);
  }

  .email {
    margin-top: 12px;
  }

  .socials {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
  }

  .socials a {
    display: flex;
    color: var(--color-muted);
    transition: color 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .socials a:hover {
    color: var(--color-ink);
  }
</style>
