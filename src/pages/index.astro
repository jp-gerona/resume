---
import { getEntry } from "astro:content";
import Profile from "@/components/Profile.astro";
import ResumeText from "@/components/ResumeText.astro";
import { siteConfig } from "@/site.config";
import { getResumeUpdatedDate } from "@/utils/resumeUpdated";
import "@/styles/global.css";

const entry = await getEntry("resume", "resume");
if (!entry) {
  throw new Error("Missing resume content entry at src/content/resume/resume.yaml");
}
const resume = entry.data;
const updatedDate = getResumeUpdatedDate();
const updatedLabel = new Intl.DateTimeFormat(siteConfig.lang, {
  year: "numeric",
  month: "long",
  day: "numeric",
  hour: "numeric",
  minute: "2-digit",
}).format(updatedDate);

const pageTitle = `${resume.title} - ${resume.name}`;
const pageDescription = resume.description ?? pageTitle;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/og-image.png", Astro.site).href;
---

<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={resume.name} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={siteConfig.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/fonts/eb-garamond-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to resume</a>
    <div class="layout">
      <aside class="sidebar" aria-label="Profile">
        <Profile />
        <div>
          <a class="text-link" href="/resume.pdf" download={siteConfig.pdfFilename}>Download PDF</a>
          <p class="updated">Updated <time datetime={updatedDate.toISOString()}>{updatedLabel}</time></p>
        </div>
      </aside>

      <main id="main-content" class="resume" tabindex="-1">
        <header class="resume-header">
          <h1>{resume.name}</h1>
          <address>
            {resume.contact.map((contact, index) => (
              <>
                {index > 0 && <span class="separator" aria-hidden="true"> | </span>}
                <span class="contact">{contact.href ? <a href={contact.href}>{contact.text}</a> : contact.text}</span>
              </>
            ))}
          </address>
        </header>

        <section aria-labelledby="education">
          <h2 id="education">Education</h2>
          {resume.education.map(item => (
            <div class="entry">
              <div class="row"><h3>{item.institution}</h3><strong class="row-end">{item.location}</strong></div>
              <div class="row"><p>{item.credential}</p><p class="row-end">{item.period}</p></div>
              <div class="details">{item.details.map(detail => <p><ResumeText text={detail} /></p>)}</div>
            </div>
          ))}
        </section>

        <section aria-labelledby="experience">
          <h2 id="experience">Work Experience</h2>
          {resume.experience.map(item => (
            <div class="entry">
              <div class="row"><h3>{item.organization}</h3><strong class="row-end">{item.location}</strong></div>
              <div class="row"><p>{item.role}</p><p class="row-end">{item.period}</p></div>
              <ul>{item.highlights.map(highlight => <li><ResumeText text={highlight} /></li>)}</ul>
            </div>
          ))}
        </section>

        <section aria-labelledby="projects">
          <h2 id="projects">Projects</h2>
          {resume.projects.map(item => (
            <div class="entry">
              <div class="row"><h3>{item.name}</h3><strong class="row-end">{item.year}</strong></div>
              <ul>{item.highlights.map(highlight => <li><ResumeText text={highlight} /></li>)}</ul>
            </div>
          ))}
        </section>

        <section aria-labelledby="affiliations">
          <h2 id="affiliations">Affiliations</h2>
          {resume.affiliations.map(item => (
            <div class="entry">
              <div class="row"><h3>{item.organization}</h3><strong class="row-end">{item.period}</strong></div>
              <ul>{item.highlights.map(highlight => <li><ResumeText text={highlight} /></li>)}</ul>
            </div>
          ))}
        </section>

        <section aria-labelledby="skills">
          <h2 id="skills">Skills</h2>
          {resume.skills.map(skill => <p class="skill"><strong>{skill.category}:</strong> {skill.text}</p>)}
        </section>
      </main>
    </div>
  </body>
</html>

<style>
  .layout {
    display: grid;
    gap: 40px;
    max-width: 1152px;
    margin-inline: auto;
    padding: 48px 18px;
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-self: start;
    gap: 32px;
  }

  .updated {
    margin-top: 12px;
    font-size: 0.75rem;
    line-height: 1rem;
    color: var(--color-muted);
  }

  .resume {
    min-width: 0;
    font-family: var(--font-resume);
    font-size: 15px;
    line-height: 1.14;
    font-variant-ligatures: none;
  }

  .resume-header {
    margin-bottom: 18px;
    text-align: center;
  }

  h1 {
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  address {
    margin-top: 2px;
    font-size: 13px;
    font-style: normal;
  }

  .separator {
    white-space: pre;
  }

  address a:hover {
    text-decoration: underline;
  }

  section + section {
    margin-top: 10px;
  }

  h2 {
    margin-bottom: 3px;
    border-bottom: 1px solid currentColor;
    font-size: 1rem;
    line-height: 1.5rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  h3 {
    font-weight: 700;
  }

  .entry + .entry {
    margin-top: 9px;
  }

  .row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  .row-end {
    flex-shrink: 0;
    text-align: right;
  }

  .details,
  ul {
    padding-left: 20px;
  }

  ul {
    list-style: disc;
  }

  .skill {
    padding-left: 20px;
    text-indent: -20px;
  }

  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: 224px minmax(0, 1fr);
      gap: 18px;
    }

    .sidebar {
      position: sticky;
      top: 48px;
      min-height: calc(100svh - 96px);
    }
  }

  @media (max-width: 600px) {
    .resume {
      font-size: 1rem;
      line-height: 1.3;
    }

    address {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 2px 12px;
    }

    .separator {
      display: none;
    }

    .contact {
      display: inline-block;
      overflow-wrap: anywhere;
    }

    section + section {
      margin-top: 16px;
    }

    .row {
      flex-wrap: wrap;
      gap: 0 12px;
    }

    .row-end {
      flex-shrink: 1;
      text-align: left;
    }
  }

  @media print {
    .layout {
      display: block;
      padding: 0;
    }

    .sidebar {
      display: none;
    }
  }
</style>
