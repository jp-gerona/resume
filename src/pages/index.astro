---
import { getEntry } from "astro:content";
import DownloadPdf from "@/components/DownloadPdf.astro";
import Profile from "@/components/Profile.astro";
import ResumeText from "@/components/ResumeText.astro";
import "@/styles/global.css";
import config from "../../resume.config.ts";
import { fontFaceCss, fonts as fontCatalog, fontStack } from "../../scripts/fonts.ts";

const fontUrls = Object.fromEntries(
  Object.entries(import.meta.glob<string>("../fonts/*.woff2", { query: "?url", import: "default", eager: true }))
    .map(([path, url]) => [path.split("/").pop()!.replace(".woff2", ""), url]),
);
const { fonts, sidebar } = config;
const fontCss = [
  fontFaceCss([fonts.resume, fonts.handle, fonts.ui], fontUrls),
  `:root{--font-sans:${fontStack(fonts.ui)};--font-serif:${fontStack(fonts.handle)};--font-resume:${fontStack(fonts.resume)}}`,
].join("\n");
const preloadFont = fontUrls[`${fontCatalog[fonts.resume].files.normal}-latin`];

const entry = await getEntry("resume", "resume");
if (!entry) {
  throw new Error("Missing resume content entry at src/content/resume/resume.yaml");
}
const resume = entry.data;
type SectionId = "education" | "experience" | "projects" | "affiliations" | "skills";

const pageTitle = `${resume.title} - ${resume.name}`;
const pageDescription = resume.description ?? pageTitle;
// Without a known site URL (local builds), absolute canonical and OG URLs are skipped.
const canonicalURL = Astro.site && new URL(import.meta.env.BASE_URL.replace(/\/?$/, "/"), Astro.site);
const ogImageURL = canonicalURL && new URL("og-image.png", canonicalURL).href;
---

<!doctype html>
<html lang={config.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={resume.name} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <meta property="og:type" content="website" />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    {config.locale && <meta property="og:locale" content={config.locale} />}
    <meta name="twitter:card" content="summary_large_image" />

    <style is:inline set:html={fontCss}></style>
    <link rel="preload" href={preloadFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to resume</a>
    <div class:list={["layout", { "has-sidebar": sidebar.enabled }]}>
      {sidebar.enabled && (
        <aside class="sidebar" aria-label="Profile">
          <Profile />
          <DownloadPdf />
        </aside>
      )}

      <main id="main-content" class="resume" tabindex="-1">
        <header class="resume-header">
          <h1>{resume.name}</h1>
          <address>
            {resume.contact.map((contact, index) => (
              <>
                {index > 0 && <span class="separator" aria-hidden="true"> | </span>}
                <span class="contact">{contact.href ? <a href={contact.href}>{contact.text}</a> : contact.text}</span>
              </>
            ))}
          </address>
        </header>

        {config.sections.map(({ id, title }) => (
          resume[id as SectionId].length > 0 && (
            <section aria-labelledby={id}>
              <h2 id={id}>{title}</h2>
              {id === "education" && resume.education.map(item => (
                <div class="entry">
                  <div class="row"><h3>{item.institution}</h3><strong class="row-end">{item.location}</strong></div>
                  <div class="row"><p>{item.credential}</p><p class="row-end">{item.period}</p></div>
                  <div class="details">{item.details.map(detail => <p><ResumeText text={detail} /></p>)}</div>
                </div>
              ))}
              {id === "experience" && resume.experience.map(item => (
                <div class="entry">
                  <div class="row"><h3>{item.organization}</h3><strong class="row-end">{item.location}</strong></div>
                  <div class="row"><p>{item.role}</p><p class="row-end">{item.period}</p></div>
                  <ul>{item.highlights.map(highlight => <li><ResumeText text={highlight} /></li>)}</ul>
                </div>
              ))}
              {id === "projects" && resume.projects.map(item => (
                <div class="entry">
                  <div class="row"><h3>{item.name}</h3><strong class="row-end">{item.year}</strong></div>
                  <ul>{item.highlights.map(highlight => <li><ResumeText text={highlight} /></li>)}</ul>
                </div>
              ))}
              {id === "affiliations" && resume.affiliations.map(item => (
                <div class="entry">
                  <div class="row"><h3>{item.organization}</h3><strong class="row-end">{item.period}</strong></div>
                  <ul>{item.highlights.map(highlight => <li><ResumeText text={highlight} /></li>)}</ul>
                </div>
              ))}
              {id === "skills" && resume.skills.map(skill => <p class="skill"><strong>{skill.category}:</strong> {skill.text}</p>)}
            </section>
          )
        ))}
      </main>

      {!sidebar.enabled && <footer class="footer"><DownloadPdf /></footer>}
    </div>
  </body>
</html>

<style>
  .layout {
    display: grid;
    gap: 40px;
    max-width: 1152px;
    margin-inline: auto;
    padding: 48px 18px;
  }

  .layout:not(.has-sidebar) {
    max-width: 816px;
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-self: start;
    gap: 32px;
  }

  .footer {
    text-align: center;
  }

  .resume {
    min-width: 0;
    font-family: var(--font-resume);
    font-size: 15px;
    line-height: 1.14;
    font-variant-ligatures: none;
  }

  .resume-header {
    margin-bottom: 18px;
    text-align: center;
  }

  h1 {
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  address {
    margin-top: 2px;
    font-size: 13px;
    font-style: normal;
  }

  .separator {
    white-space: pre;
  }

  address a:hover {
    text-decoration: underline;
  }

  section + section {
    margin-top: 10px;
  }

  h2 {
    margin-bottom: 3px;
    border-bottom: 1px solid currentColor;
    font-size: 1rem;
    line-height: 1.5rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  h3 {
    font-weight: 700;
  }

  .entry + .entry {
    margin-top: 9px;
  }

  .row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  .row-end {
    flex-shrink: 0;
    text-align: right;
  }

  .details,
  ul {
    padding-left: 20px;
  }

  ul {
    list-style: disc;
  }

  .skill {
    padding-left: 20px;
    text-indent: -20px;
  }

  @media (min-width: 1024px) {
    .has-sidebar {
      grid-template-columns: 224px minmax(0, 1fr);
      gap: 18px;
    }

    .sidebar {
      position: sticky;
      top: 48px;
      min-height: calc(100svh - 96px);
    }
  }

  @media (max-width: 600px) {
    .resume {
      font-size: 1rem;
      line-height: 1.3;
    }

    address {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 2px 12px;
    }

    .separator {
      display: none;
    }

    .contact {
      display: inline-block;
      overflow-wrap: anywhere;
    }

    section + section {
      margin-top: 16px;
    }

    .row {
      flex-wrap: wrap;
      gap: 0 12px;
    }

    .row-end {
      flex-shrink: 1;
      text-align: left;
    }
  }

  @media print {
    .layout {
      display: block;
      padding: 0;
    }

    .sidebar,
    .footer {
      display: none;
    }
  }
</style>
